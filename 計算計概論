      <div class="social-links">
        <a href="mailto:your.email@example.com">Email 聯絡我</a>
        <a href="https://github.com/你的帳號" target="_blank">GitHub</a>
        <a href="#" target="_blank">Instagram / Threads</a>
      </div>
    </div>
  </section>

  <!-- 2. 技能展示區 -->
  <section id="skills">
