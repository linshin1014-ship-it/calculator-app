          <a href="#" class="project-link">查看專案 &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <footer>
    <p>&copy; 2026 你的名字. Built with HTML, CSS & GitHub Pages.</p>
  </footer>

</body>
</html>
